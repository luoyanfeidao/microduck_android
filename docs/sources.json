      "text": "        ndk { abiFilters 'arm64-v8a' }\n        externalNativeBuild {\n            cmake {\n                arguments '-DANDROID_STL=c++_static', '-DFETCHCONTENT_UPDATES_DISCONNECTED=ON'\n                targets 'microduck_m1'\n            }\n        }\n    }\n    externalNativeBuild {\n        cmake { path file('src/main/cpp/CMakeLists.txt'); version '3.30.3' }\n    }"
