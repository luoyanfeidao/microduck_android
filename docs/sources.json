      "file": "Pollen/microduck/duck-control/src/obs.rs",
      "start": 174,
      "end": 188,
      "text": "    pub fn build(\n        imu: &ImuData,\n        joint_positions: &[f64; NUM_JOINTS],\n        joint_velocities: &[f64; NUM_JOINTS],\n        home_pose: &[f64; NUM_JOINTS],\n        last_action: &[f32; ACTION_LEN],\n        command: &Command,\n    ) -> Self {\n        let mut data = [0.0f32; OBS_LEN];\n\n        // Carve the buffer into the blocks of the layout table above, by name — as\n        // *arrays*, so each block's width is in its type and [`fill`] can only be handed a\n        // source of matching length. `expect` cannot fire: the widths are constants that\n        // sum to `OBS_LEN`, which `the_layout_widths_sum_to_the_declared_input` pins.\n        const LAYOUT: &str = \"block widths must sum to OBS_LEN\";"
    },
    {
      "file": "android-sim/app/src/main/java/com/microduck/sim/PolicyRunner.java",
      "start": 97,
      "end": 103,
      "text": "    void tick(long handle) throws Exception {\n        double[] result=RustControl.tick(rustCore,NativeSim.bodySample(handle),\n            new double[]{command[0],command[1],command[2]},filter,this);\n        NativeSim.bodyGain(handle,(int)result[15]);\n        NativeSim.bodyTargets(handle,Arrays.copyOf(result,15));\n        fallen=result[17]!=0;\n    }"
    },
    {
      "file": "android-sim/app/src/main/java/com/microduck/sim/PolicyRunner.java",
      "start": 90,
      "end": 96,
      "text": "    float[] rustInfer(int net,float[] observation) throws Exception {\n        String[] names={\"alpha_stand\",\"alpha_walking\",\"roulade\"};\n        if(net<0 || net>=names.length) throw new IllegalStateException(\"Unsupported Rust policy\");\n        active=names[net];\n        long start=System.nanoTime();float[] action=infer(sessions.get(active),observation);\n        inferenceMs=(System.nanoTime()-start)/1e6;return action;\n    }"
    },
    {
      "file": "android-sim/app/src/main/cpp/bam_actuator.h",
      "start": 18,
      "end": 21,
      "text": "inline double torque(double target,double q,double velocity,double kp,double volts) {\n    const double duty=std::clamp((target-q)*kp*ERROR_GAIN,-1.0,1.0);\n    return KT*(volts*duty)/R-KT*KT*velocity/R;\n}"
    },
    {
      "file": "android-sim/app/src/main/cpp/bam_actuator.h",
      "start": 100,
      "end": 112,
      "text": "    void update(mjModel* m,mjData* d) {\n        if(!enabled) return;\n        double load=0; for(double t:previous_torque) load+=std::abs(t);\n        effective_volts=std::max(VIN_MIN,VIN-DROP_GAIN*load);\n        for(int i=0;i<14;++i) {\n            const auto& o=original[i]; int v=o.dof;\n            double t=powered?torque(targets[i],d->qpos[o.qpos],d->qvel[v],kp,effective_volts):0;\n            // CPU BAM uses the previous solved forces for the next friction budget.\n            double external=-d->qfrc_bias[v]+d->qfrc_constraint[v];\n            for(int e=0;e<d->nefc;++e)\n                if(d->efc_type[e]==mjCNSTR_FRICTION_DOF && d->efc_id[e]==o.joint) external-=d->efc_force[e];\n            m->dof_frictionloss[v]=friction(d->qfrc_actuator[v],external,d->qvel[v]);\n            m->dof_damping[v]=VISCOUS;"
    },
